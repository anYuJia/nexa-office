<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
<Package Name="Nexa Office" Manufacturer="Nexa Office contributors" Version="0.1.0" UpgradeCode="6F294772-C855-4B52-8AE0-C4C1432F9A10">
<MediaTemplate EmbedCab="yes"/>
<StandardDirectory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="Nexa Office">
<Component Id="MainExecutable" Guid="*">
<File Id="NexaOfficeExe" Source="$(NexaExe)" KeyPath="yes"/>
<ProgId Id="NexaOffice.Docx" Description="Nexa Office Document"><Extension Id="docx" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/></ProgId>
<ProgId Id="NexaOffice.Xlsx" Description="Nexa Office Workbook"><Extension Id="xlsx" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/></ProgId>
<ProgId Id="NexaOffice.Pptx" Description="Nexa Office Presentation"><Extension Id="pptx" ContentType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/></ProgId>
</Component></Directory></StandardDirectory>
<Feature Id="ProductFeature"><ComponentRef Id="MainExecutable"/></Feature>
</Package>
</Wix>

import { LineEdit, TextEdit } from "std-widgets.slint";

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback activated();

    height: 40px;
    border-radius: 9px;
    background: root.active ? #eef2f6 : transparent;

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.label;
        color: root.active ? #101828 : #667085;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.activated();
        }
    }
}

component ActionCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    callback activated();

    height: 116px;
    background: #ffffff;
    border-color: #e5e7eb;
    border-width: 1px;
    border-radius: 12px;

    VerticalLayout {
        padding: 18px;
        spacing: 7px;

        Text {
            text: root.title;
            color: #101828;
            font-size: 18px;
            font-weight: 600;
        }

        Text {
            text: root.subtitle;
            color: #667085;
            font-size: 13px;
        }
    }

    TouchArea {
        clicked => {
            root.activated();
        }
    }
}

component ToolButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback activated();

    height: 34px;
    min-width: 42px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? #98a2b3 : #d0d5dd;
    background: root.active ? #eef2f6 : #ffffff;
    opacity: root.enabled ? 1 : 0.45;

    Text {
        x: 11px;
        width: parent.width - 22px;
        text: root.label;
        color: #344054;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.activated();
        }
    }
}

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 52px;
    background: transparent;

    HorizontalLayout {
        spacing: 18px;

        Text {
            width: 180px;
            text: root.label;
            color: #667085;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: #101828;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback toggled();

    height: 72px;
    background: transparent;

    HorizontalLayout {
        spacing: 18px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;

            Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            Text {
                text: root.title;
                color: #101828;
                font-size: 14px;
                font-weight: 600;
            }

            Text {
                text: root.description;
                color: #667085;
                font-size: 12px;
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }
        }

        Rectangle {
            width: 42px;
            height: 24px;
            border-radius: 12px;
            background: root.checked ? #344054 : #d0d5dd;
            vertical-stretch: 0;

            Rectangle {
                width: 18px;
                height: 18px;
                x: root.checked ? 21px : 3px;
                y: 3px;
                border-radius: 9px;
                background: #ffffff;
            }

            TouchArea {
                clicked => {
                    root.toggled();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: root.page == 3 ? root.docs-title + " — Nexa Office" : "Nexa Office";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 600px;
    background: #f7f8fa;

    in-out property <int> page: 0;
    in-out property <string> status-text: "Native shell ready";
    in-out property <bool> show-status-bar: true;
    in-out property <bool> compact-navigation: false;
    in property <string> platform-text: "";
    in property <string> architecture-text: "";
    in property <string> build-text: "";
    in property <string> renderer-text: "";
    in property <string> shell-init-text: "";

    in-out property <string> docs-path-input: "";
    in-out property <string> docs-search-query: "";
    in-out property <string> docs-replace-text: "";
    in-out property <string> docs-paragraph-text: "";
    in property <string> docs-title: "Docs";
    in property <string> docs-current-path: "No document open";
    in property <string> docs-paragraph-meta: "Paragraph 0 of 0";
    in property <string> docs-page-meta: "0 pages";
    in property <string> docs-dirty-meta: "";
    in property <string> docs-compatibility-text: "";
    in property <bool> docs-bold: false;
    in property <bool> docs-italic: false;
    in property <bool> docs-underline: false;
    in property <bool> docs-can-save: false;

    callback create-docs();
    callback create-sheets();
    callback create-slides();
    callback show-home();
    callback show-docs();
    callback show-diagnostics();
    callback show-settings();
    callback toggle-status-bar();
    callback toggle-compact-navigation();

    callback docs-open-path(string);
    callback docs-save();
    callback docs-save-as(string);
    callback docs-edit-paragraph(string);
    callback docs-previous-paragraph();
    callback docs-next-paragraph();
    callback docs-insert-paragraph();
    callback docs-toggle-bold();
    callback docs-toggle-italic();
    callback docs-toggle-underline();
    callback docs-undo();
    callback docs-redo();
    callback docs-search(string);
    callback docs-replace-all(string, string);

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: root.compact-navigation ? 168px : 208px;
            background: #ffffff;
            border-color: #eaecf0;
            border-width: 1px;

            VerticalLayout {
                padding: 18px;
                spacing: 8px;

                Text {
                    height: 44px;
                    text: "Nexa";
                    color: #101828;
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 12px;
                    background: transparent;
                }

                NavButton {
                    label: "Home";
                    active: root.page == 0;
                    activated => {
                        root.show-home();
                    }
                }

                NavButton {
                    label: "Docs";
                    active: root.page == 3;
                    activated => {
                        root.show-docs();
                    }
                }

                NavButton {
                    label: "Diagnostics";
                    active: root.page == 1;
                    activated => {
                        root.show-diagnostics();
                    }
                }

                NavButton {
                    label: "Settings";
                    active: root.page == 2;
                    activated => {
                        root.show-settings();
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    height: 32px;
                    text: "Rust native · no WebView";
                    color: #98a2b3;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            padding: root.page == 3 ? 20px : 30px;
            spacing: root.page == 3 ? 12px : 22px;

            if root.page == 0 : Rectangle {
                vertical-stretch: 1;
                background: transparent;

                VerticalLayout {
                    spacing: 24px;

                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "Native office, without a browser engine.";
                            color: #101828;
                            font-size: 29px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Fast startup, bounded memory, and office-grade file integrity.";
                            color: #667085;
                            font-size: 14px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 14px;

                        ActionCard {
                            horizontal-stretch: 1;
                            title: "Docs";
                            subtitle: "DOCX documents";
                            activated => {
                                root.create-docs();
                            }
                        }

                        ActionCard {
                            horizontal-stretch: 1;
                            title: "Sheets";
                            subtitle: "XLSX workbooks · Phase 4";
                            activated => {
                                root.create-sheets();
                            }
                        }

                        ActionCard {
                            horizontal-stretch: 1;
                            title: "Slides";
                            subtitle: "PPTX presentations · Phase 5";
                            activated => {
                                root.create-slides();
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }
            }

            if root.page == 1 : Rectangle {
                vertical-stretch: 1;
                background: transparent;

                VerticalLayout {
                    spacing: 18px;

                    VerticalLayout {
                        spacing: 7px;

                        Text {
                            text: "Diagnostics";
                            color: #101828;
                            font-size: 27px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Runtime facts used to keep the native shell measurable.";
                            color: #667085;
                            font-size: 14px;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #eaecf0;
                    }

                    InfoRow { label: "Platform"; value: root.platform-text; }
                    InfoRow { label: "Architecture"; value: root.architecture-text; }
                    InfoRow { label: "Build"; value: root.build-text; }
                    InfoRow { label: "Shell renderer"; value: root.renderer-text; }
                    InfoRow { label: "Shell init"; value: root.shell-init-text; }
                    InfoRow { label: "Browser runtime"; value: "None"; }
                    InfoRow {
                        label: "Start-screen memory gate";
                        value: "Target ≤ 40 MiB · hard ≤ 60 MiB";
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }
            }

            if root.page == 2 : Rectangle {
                vertical-stretch: 1;
                background: transparent;

                VerticalLayout {
                    spacing: 18px;

                    VerticalLayout {
                        spacing: 7px;

                        Text {
                            text: "Settings";
                            color: #101828;
                            font-size: 27px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Small local preferences. No account or cloud required.";
                            color: #667085;
                            font-size: 14px;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #eaecf0;
                    }

                    SettingRow {
                        title: "Show status bar";
                        description: "Display lightweight command feedback at the bottom of the window.";
                        checked: root.show-status-bar;
                        toggled => {
                            root.toggle-status-bar();
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #eaecf0;
                    }

                    SettingRow {
                        title: "Compact navigation";
                        description: "Use a narrower sidebar to leave more horizontal room for documents.";
                        checked: root.compact-navigation;
                        toggled => {
                            root.toggle-compact-navigation();
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }
            }

            if root.page == 3 : Rectangle {
                vertical-stretch: 1;
                background: transparent;

                VerticalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        height: 48px;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: root.docs-title;
                                color: #101828;
                                font-size: 20px;
                                font-weight: 700;
                            }

                            Text {
                                text: root.docs-current-path;
                                color: #98a2b3;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: root.docs-dirty-meta;
                            color: root.docs-dirty-meta == "Saved" ? #667085 : #b54708;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 46px;
                        background: #ffffff;
                        border-color: #eaecf0;
                        border-width: 1px;
                        border-radius: 10px;

                        HorizontalLayout {
                            padding: 6px;
                            spacing: 6px;

                            ToolButton {
                                label: "Undo";
                                activated => { root.docs-undo(); }
                            }
                            ToolButton {
                                label: "Redo";
                                activated => { root.docs-redo(); }
                            }

                            Rectangle { width: 1px; background: #eaecf0; }

                            ToolButton {
                                label: "B";
                                active: root.docs-bold;
                                activated => { root.docs-toggle-bold(); }
                            }
                            ToolButton {
                                label: "I";
                                active: root.docs-italic;
                                activated => { root.docs-toggle-italic(); }
                            }
                            ToolButton {
                                label: "U";
                                active: root.docs-underline;
                                activated => { root.docs-toggle-underline(); }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            ToolButton {
                                label: "Save";
                                enabled: root.docs-can-save;
                                activated => { root.docs-save(); }
                            }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        background: #ffffff;
                        border-color: #eaecf0;
                        border-width: 1px;
                        border-radius: 10px;

                        HorizontalLayout {
                            padding: 6px;
                            spacing: 7px;

                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.docs-path-input;
                                placeholder-text: "/path/to/document.docx";
                                accepted(path) => {
                                    root.docs-open-path(path);
                                }
                            }

                            ToolButton {
                                label: "Open";
                                activated => { root.docs-open-path(root.docs-path-input); }
                            }

                            ToolButton {
                                label: "Save As";
                                enabled: root.docs-can-save;
                                activated => { root.docs-save-as(root.docs-path-input); }
                            }
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;

                        Rectangle {
                            width: 224px;
                            background: #ffffff;
                            border-color: #eaecf0;
                            border-width: 1px;
                            border-radius: 10px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                Text {
                                    text: "Document";
                                    color: #101828;
                                    font-size: 13px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: root.docs-page-meta;
                                    color: #667085;
                                    font-size: 12px;
                                }

                                Text {
                                    text: root.docs-paragraph-meta;
                                    color: #667085;
                                    font-size: 12px;
                                }

                                Rectangle {
                                    height: 1px;
                                    background: #eaecf0;
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: "Previous";
                                        activated => { root.docs-previous-paragraph(); }
                                    }

                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: "Next";
                                        activated => { root.docs-next-paragraph(); }
                                    }
                                }

                                ToolButton {
                                    label: "Insert paragraph";
                                    activated => { root.docs-insert-paragraph(); }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: #eaecf0;
                                }

                                Text {
                                    text: "Find & replace";
                                    color: #101828;
                                    font-size: 13px;
                                    font-weight: 700;
                                }

                                LineEdit {
                                    text <=> root.docs-search-query;
                                    placeholder-text: "Find text";
                                    accepted(query) => { root.docs-search(query); }
                                }

                                LineEdit {
                                    text <=> root.docs-replace-text;
                                    placeholder-text: "Replace with";
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: "Find";
                                        activated => { root.docs-search(root.docs-search-query); }
                                    }

                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: "Replace all";
                                        activated => {
                                            root.docs-replace-all(
                                                root.docs-search-query,
                                                root.docs-replace-text
                                            );
                                        }
                                    }
                                }

                                Rectangle {
                                    vertical-stretch: 1;
                                    background: transparent;
                                }

                                Text {
                                    text: root.docs-compatibility-text;
                                    color: root.docs-can-save ? #027a48 : #b42318;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: #ffffff;
                            border-color: #eaecf0;
                            border-width: 1px;
                            border-radius: 10px;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;

                                Text {
                                    text: root.docs-paragraph-meta;
                                    color: #667085;
                                    font-size: 12px;
                                }

                                Rectangle {
                                    vertical-stretch: 1;
                                    background: #fcfcfd;
                                    border-color: #e4e7ec;
                                    border-width: 1px;
                                    border-radius: 8px;

                                    TextEdit {
                                        x: 14px;
                                        y: 14px;
                                        width: parent.width - 28px;
                                        height: parent.height - 28px;
                                        text <=> root.docs-paragraph-text;
                                        font-size: 15px;
                                        edited(text) => {
                                            root.docs-edit-paragraph(text);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.show-status-bar : Rectangle {
                height: 42px;
                background: #ffffff;
                border-color: #eaecf0;
                border-width: 1px;
                border-radius: 9px;

                Text {
                    x: 13px;
                    width: parent.width - 26px;
                    text: root.status-text;
                    color: #475467;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }
    }
}

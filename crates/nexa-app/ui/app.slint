import { LineEdit, TextEdit } from "std-widgets.slint";

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    in property <bool> compact;
    callback activated();

    height: 42px;
    border-radius: 9px;
    background: root.active ? #eef4ff : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }

    Rectangle {
        x: 7px;
        y: 9px;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: root.active ? #2563eb : #f2f4f7;

        Text {
            text: root.glyph;
            color: root.active ? #ffffff : #667085;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if !root.compact : Text {
        x: 42px;
        width: parent.width - 52px;
        text: root.label;
        color: root.active ? #1849a9 : #475467;
        font-size: 13px;
        font-weight: root.active ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}

component ToolButton inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> quiet: false;
    callback activated();

    height: 34px;
    min-width: 40px;
    border-radius: 8px;
    border-width: root.quiet ? 0px : 1px;
    border-color: root.active ? #84adff : #e4e7ec;
    background: root.active ? #eef4ff : (root.quiet ? transparent : #ffffff);
    opacity: root.enabled ? 1 : 0.42;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.activated();
        }
    }

    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.label;
        color: root.active ? #175cd3 : #344054;
        font-size: 12px;
        font-weight: root.active ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

component LaunchRow inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> subtitle;
    in property <string> meta;
    in property <bool> primary: false;
    callback activated();

    height: 82px;
    background: transparent;
    border-color: #eaecf0;
    border-width: 0px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.subtitle;
    accessible-action-default => { root.activated(); }

    Rectangle {
        x: 0px;
        y: 13px;
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: root.primary ? #2563eb : #f2f4f7;

        Text {
            text: root.glyph;
            color: root.primary ? #ffffff : #475467;
            font-size: 17px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        x: 72px;
        y: 15px;
        width: parent.width - 190px;
        height: 52px;
        spacing: 4px;

        Text {
            text: root.title;
            color: #101828;
            font-size: 15px;
            font-weight: 650;
            vertical-alignment: center;
        }

        Text {
            text: root.subtitle;
            color: #667085;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Text {
        x: parent.width - 112px;
        width: 92px;
        text: root.meta;
        color: root.primary ? #175cd3 : #98a2b3;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 14px;
        width: 14px;
        text: "›";
        color: #98a2b3;
        font-size: 22px;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #f0f1f3;
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}

component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback toggled();

    height: 72px;
    background: transparent;
    accessible-role: switch;
    accessible-label: root.title;
    accessible-description: root.description;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }

    VerticalLayout {
        x: 0px;
        y: 13px;
        width: parent.width - 70px;
        height: 46px;
        spacing: 3px;

        Text {
            text: root.title;
            color: #101828;
            font-size: 13px;
            font-weight: 600;
        }

        Text {
            text: root.description;
            color: #667085;
            font-size: 11px;
            overflow: elide;
        }
    }

    Rectangle {
        x: parent.width - 48px;
        y: 24px;
        width: 42px;
        height: 24px;
        border-radius: 12px;
        background: root.checked ? #2563eb : #d0d5dd;

        Rectangle {
            width: 18px;
            height: 18px;
            x: root.checked ? 21px : 3px;
            y: 3px;
            border-radius: 9px;
            background: #ffffff;
        }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

component LanguageChoice inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();

    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? #84adff : #e4e7ec;
    background: root.selected ? #eef4ff : #ffffff;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }

    Text {
        text: root.label;
        color: root.selected ? #175cd3 : #475467;
        font-size: 12px;
        font-weight: root.selected ? 650 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}

component MetricRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 48px;
    background: transparent;

    Text {
        x: 0px;
        width: 180px;
        text: root.label;
        color: #667085;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: 190px;
        width: parent.width - 190px;
        text: root.value;
        color: #101828;
        font-size: 12px;
        font-weight: 550;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #f2f4f7;
    }
}

export struct SheetRow {
    row-index: int,
    row-label: string,
    c0: string,
    c1: string,
    c2: string,
    c3: string,
    c4: string,
    c5: string,
    c6: string,
    c7: string,
    c8: string,
    c9: string,
}

export struct SlideElementRow {
    index: int,
    kind: string,
    text: string,
}

component SheetHeaderCell inherits Rectangle {
    in property <string> label;

    height: 28px;
    background: #f7f8fa;
    border-color: #e4e7ec;
    border-width: 1px;

    Text {
        text: root.label;
        color: #667085;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component SheetGridCell inherits Rectangle {
    in property <string> value;
    in property <bool> active;
    in property <string> accessible-name;
    callback activated();

    height: 28px;
    background: root.active ? #eef4ff : #ffffff;
    border-color: root.active ? #3974db : #e8eaed;
    border-width: root.active ? 2px : 1px;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.activated(); }

    Text {
        x: 7px;
        width: parent.width - 14px;
        text: root.value;
        color: #1d2939;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => { root.activated(); }
    }
}

export component AppWindow inherits Window {
    title: root.page == 3
        ? root.docs-title + " — Nexa Office"
        : (root.page == 4
            ? root.sheets-title + " — Nexa Office"
            : (root.page == 5 ? root.slides-title + " — Nexa Office" : "Nexa Office"));
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 840px;
    min-height: 560px;
    background: #f6f7f9;

    in-out property <int> page: 0;
    in-out property <string> status-text: "Native shell ready";
    in-out property <bool> show-status-bar: true;
    in-out property <bool> compact-navigation: false;
    in-out property <bool> is-chinese: false;
    in-out property <int> language-mode: 0;

    in property <string> platform-text: "";
    in property <string> architecture-text: "";
    in property <string> build-text: "";
    in property <string> renderer-text: "";
    in property <string> shell-init-text: "";

    in-out property <string> docs-path-input: "";
    in-out property <string> docs-search-query: "";
    in-out property <string> docs-replace-text: "";
    in-out property <string> docs-paragraph-text: "";
    in property <string> docs-title: "Docs";
    in property <string> docs-current-path: "";
    in property <string> docs-paragraph-meta: "";
    in property <string> docs-page-meta: "";
    in property <string> docs-dirty-meta: "";
    in property <string> docs-compatibility-text: "";
    in property <bool> docs-bold: false;
    in property <bool> docs-italic: false;
    in property <bool> docs-underline: false;
    in property <bool> docs-can-save: false;

    in-out property <string> sheets-path-input: "";
    in-out property <string> sheets-filter-input: "";
    in-out property <string> sheets-address-input: "A1";
    in-out property <string> sheets-cell-input: "";
    in property <string> sheets-title: "Sheets";
    in property <string> sheets-current-path: "";
    in property <string> sheets-dirty-meta: "";
    in property <string> sheets-compatibility-text: "";
    in property <string> sheets-sheet-name: "";
    in property <bool> sheets-bold: false;
    in property <bool> sheets-italic: false;
    in property <bool> sheets-can-save: false;
    in property <int> sheets-active-row: 0;
    in property <int> sheets-active-column: 0;
    in property <int> sheets-viewport-column: 0;
    in property <SheetRow> sheets-header;
    in property <[SheetRow]> sheets-rows;

    in-out property <string> slides-path-input: "";
    in-out property <string> slides-selected-text: "";
    in property <string> slides-title: "Slides";
    in property <string> slides-current-path: "";
    in property <string> slides-dirty-meta: "";
    in property <string> slides-compatibility-text: "";
    in property <string> slides-slide-meta: "";
    in property <bool> slides-can-save: false;
    in property <[SlideElementRow]> slides-elements;

    private property <bool> nav-compact: root.compact-navigation;
    private property <bool> dense-docs: root.compact-navigation;

    callback create-docs();
    callback create-sheets();
    callback create-slides();
    callback show-home();
    callback show-docs();
    callback show-diagnostics();
    callback show-settings();
    callback toggle-status-bar();
    callback toggle-compact-navigation();
    callback set-language(int);

    callback docs-open-path(string);
    callback docs-save();
    callback docs-save-as(string);
    callback docs-edit-paragraph(string);
    callback docs-previous-paragraph();
    callback docs-next-paragraph();
    callback docs-insert-paragraph();
    callback docs-toggle-bold();
    callback docs-toggle-italic();
    callback docs-toggle-underline();
    callback docs-undo();
    callback docs-redo();
    callback docs-search(string);
    callback docs-replace-all(string, string);

    callback sheets-open-path(string);
    callback sheets-save();
    callback sheets-save-as(string);
    callback sheets-select-cell(int, int);
    callback sheets-select-address(string);
    callback sheets-edit-cell(string);
    callback sheets-toggle-bold();
    callback sheets-toggle-italic();
    callback sheets-toggle-fill();
    callback sheets-scroll(int, int);
    callback sheets-sort(bool);
    callback sheets-filter(string);
    callback sheets-clear-filter();
    callback sheets-freeze-row();
    callback sheets-freeze-column();
    callback sheets-add-sheet();

    callback slides-open-path(string);
    callback slides-save();
    callback slides-save-as(string);
    callback slides-previous();
    callback slides-next();
    callback slides-add-slide();
    callback slides-duplicate();
    callback slides-delete-slide();
    callback slides-add-text();
    callback slides-add-shape();
    callback slides-add-table();
    callback slides-select-element(int);
    callback slides-edit-text(string);
    callback slides-delete-element();
    callback slides-bring-forward();
    callback slides-send-backward();

    MenuBar {
        Menu {
            title: root.is-chinese ? "文件" : "File";

            MenuItem {
                title: root.is-chinese ? "新建文档" : "New Document";
                shortcut: @keys(Control + N);
                activated => { root.create-docs(); }
            }

            MenuItem {
                title: root.is-chinese ? "新建表格" : "New Spreadsheet";
                activated => { root.create-sheets(); }
            }

            MenuItem {
                title: root.is-chinese ? "新建演示文稿" : "New Presentation";
                activated => { root.create-slides(); }
            }

            MenuItem {
                title: root.is-chinese ? "保存" : "Save";
                shortcut: @keys(Control + S);
                enabled: (root.page == 3 && root.docs-can-save)
                    || (root.page == 4 && root.sheets-can-save)
                    || (root.page == 5 && root.slides-can-save);
                activated => {
                    if (root.page == 3) {
                        root.docs-save();
                    } else if (root.page == 4) {
                        root.sheets-save();
                    } else if (root.page == 5) {
                        root.slides-save();
                    }
                }
            }
        }

        Menu {
            title: root.is-chinese ? "编辑" : "Edit";

            MenuItem {
                title: root.is-chinese ? "撤销" : "Undo";
                shortcut: @keys(Control + Z);
                enabled: root.page == 3;
                activated => { root.docs-undo(); }
            }

            MenuItem {
                title: root.is-chinese ? "重做" : "Redo";
                shortcut: @keys(Control + Shift + Z);
                enabled: root.page == 3;
                activated => { root.docs-redo(); }
            }

            MenuItem {
                title: root.is-chinese ? "粗体" : "Bold";
                shortcut: @keys(Control + B);
                enabled: root.page == 3;
                activated => { root.docs-toggle-bold(); }
            }

            MenuItem {
                title: root.is-chinese ? "斜体" : "Italic";
                shortcut: @keys(Control + I);
                enabled: root.page == 3;
                activated => { root.docs-toggle-italic(); }
            }

            MenuItem {
                title: root.is-chinese ? "下划线" : "Underline";
                shortcut: @keys(Control + U);
                enabled: root.page == 3;
                activated => { root.docs-toggle-underline(); }
            }
        }

        Menu {
            title: root.is-chinese ? "视图" : "View";

            MenuItem {
                title: root.is-chinese ? "显示状态栏" : "Show Status Bar";
                checkable: true;
                checked: root.show-status-bar;
                activated => { root.toggle-status-bar(); }
            }

            MenuItem {
                title: root.is-chinese ? "紧凑导航" : "Compact Navigation";
                checkable: true;
                checked: root.compact-navigation;
                activated => { root.toggle-compact-navigation(); }
            }
        }
    }

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: root.nav-compact ? 68px : 204px;
            background: #ffffff;
            border-color: #eaecf0;
            border-width: 1px;
            accessible-role: navigation;
            accessible-label: root.is-chinese ? "主导航" : "Main navigation";

            VerticalLayout {
                padding-left: root.nav-compact ? 10px : 14px;
                padding-right: root.nav-compact ? 10px : 14px;
                padding-top: 16px;
                padding-bottom: 14px;
                spacing: 6px;

                Rectangle {
                    height: 46px;
                    background: transparent;

                    Rectangle {
                        x: root.nav-compact ? 7px : 4px;
                        y: 5px;
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: #101828;

                        Text {
                            text: "N";
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if !root.nav-compact : VerticalLayout {
                        x: 48px;
                        y: 5px;
                        width: parent.width - 48px;
                        height: 35px;
                        spacing: 0px;

                        Text {
                            text: "Nexa Office";
                            color: #101828;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.is-chinese ? "原生 · 轻量" : "Native · Lightweight";
                            color: #98a2b3;
                            font-size: 9px;
                        }
                    }
                }

                Rectangle { height: 9px; background: transparent; }

                NavItem {
                    glyph: "H";
                    label: root.is-chinese ? "首页" : "Home";
                    compact: root.nav-compact;
                    active: root.page == 0;
                    activated => { root.show-home(); }
                }

                NavItem {
                    glyph: "D";
                    label: root.is-chinese ? "文档" : "Docs";
                    compact: root.nav-compact;
                    active: root.page == 3;
                    activated => { root.show-docs(); }
                }

                NavItem {
                    glyph: "S";
                    label: root.is-chinese ? "表格" : "Sheets";
                    compact: root.nav-compact;
                    active: root.page == 4;
                    activated => { root.create-sheets(); }
                }

                NavItem {
                    glyph: "P";
                    label: root.is-chinese ? "演示" : "Slides";
                    compact: root.nav-compact;
                    active: root.page == 5;
                    activated => { root.create-slides(); }
                }

                Rectangle { height: 14px; background: transparent; }

                if !root.nav-compact : Text {
                    height: 24px;
                    text: root.is-chinese ? "系统" : "SYSTEM";
                    color: #98a2b3;
                    font-size: 9px;
                    font-weight: 650;
                    vertical-alignment: center;
                }

                NavItem {
                    glyph: "i";
                    label: root.is-chinese ? "诊断" : "Diagnostics";
                    compact: root.nav-compact;
                    active: root.page == 1;
                    activated => { root.show-diagnostics(); }
                }

                NavItem {
                    glyph: "S";
                    label: root.is-chinese ? "设置" : "Settings";
                    compact: root.nav-compact;
                    active: root.page == 2;
                    activated => { root.show-settings(); }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                if !root.nav-compact : Text {
                    height: 30px;
                    text: "Rust + Slint";
                    color: #98a2b3;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            accessible-role: main;
            accessible-label: root.is-chinese ? "主要内容" : "Main content";

            if root.page == 0 : Rectangle {
                vertical-stretch: 1;
                background: #f8f9fb;

                VerticalLayout {
                    padding-left: root.nav-compact ? 30px : 56px;
                    padding-right: root.nav-compact ? 30px : 56px;
                    padding-top: root.nav-compact ? 40px : 48px;
                    padding-bottom: 32px;
                    spacing: 26px;

                    VerticalLayout {
                        height: 100px;
                        spacing: 8px;

                        Text {
                            text: root.is-chinese ? "今天想处理什么？" : "What are you working on?";
                            color: #101828;
                            font-size: 30px;
                            font-weight: 720;
                        }

                        Text {
                            text: root.is-chinese
                                ? "原生 Rust 办公套件，不依赖浏览器内核。"
                                : "A native Rust office suite without a browser engine.";
                            color: #667085;
                            font-size: 13px;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #e4e7ec;
                    }

                    VerticalLayout {
                        spacing: 0px;

                        Text {
                            height: 36px;
                            text: root.is-chinese ? "新建" : "CREATE";
                            color: #98a2b3;
                            font-size: 10px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }

                        LaunchRow {
                            glyph: "D";
                            title: root.is-chinese ? "新建文档" : "New document";
                            subtitle: root.is-chinese
                                ? "DOCX · 段落、格式、搜索、撤销与安全保存"
                                : "DOCX · paragraphs, formatting, search, undo and safe save";
                            meta: root.is-chinese ? "可用" : "Ready";
                            primary: true;
                            activated => { root.create-docs(); }
                        }

                        LaunchRow {
                            glyph: "S";
                            title: root.is-chinese ? "新建表格" : "New spreadsheet";
                            subtitle: root.is-chinese
                                ? "XLSX · 稀疏工作簿与虚拟化视口"
                                : "XLSX · sparse workbook and virtualized viewport";
                            meta: root.is-chinese ? "可用" : "Ready";
                            activated => { root.create-sheets(); }
                        }

                        LaunchRow {
                            glyph: "P";
                            title: root.is-chinese ? "新建演示" : "New presentation";
                            subtitle: root.is-chinese
                                ? "PPTX · 原生演示文稿引擎"
                                : "PPTX · native presentation engine";
                            meta: "Phase 5";
                            activated => { root.create-slides(); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    HorizontalLayout {
                        height: 34px;
                        spacing: 18px;

                        Text {
                            text: root.is-chinese
                                ? "无 WebView · 文件兼容性优先 · 性能门禁"
                                : "No WebView · File integrity first · Performance gated";
                            color: #98a2b3;
                            font-size: 10px;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; background: transparent; }

                        Text {
                            text: root.is-chinese ? "Docs + Sheets 可用" : "Docs + Sheets ready";
                            color: #667085;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.page == 1 : Rectangle {
                vertical-stretch: 1;
                background: #f8f9fb;

                VerticalLayout {
                    padding: 48px;
                    spacing: 20px;

                    VerticalLayout {
                        height: 72px;
                        spacing: 7px;

                        Text {
                            text: root.is-chinese ? "运行诊断" : "Runtime diagnostics";
                            color: #101828;
                            font-size: 27px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.is-chinese
                                ? "用于确认 Nexa 始终保持原生、轻量且可测量。"
                                : "Runtime facts that keep Nexa native, lightweight and measurable.";
                            color: #667085;
                            font-size: 12px;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #e4e7ec;
                    }

                    VerticalLayout {
                        spacing: 0px;

                        MetricRow {
                            label: root.is-chinese ? "平台" : "Platform";
                            value: root.platform-text;
                        }
                        MetricRow {
                            label: root.is-chinese ? "架构" : "Architecture";
                            value: root.architecture-text;
                        }
                        MetricRow {
                            label: root.is-chinese ? "构建" : "Build";
                            value: root.build-text;
                        }
                        MetricRow {
                            label: root.is-chinese ? "渲染器" : "Shell renderer";
                            value: root.renderer-text;
                        }
                        MetricRow {
                            label: root.is-chinese ? "Shell 初始化" : "Shell init";
                            value: root.shell-init-text;
                        }
                        MetricRow {
                            label: root.is-chinese ? "浏览器运行时" : "Browser runtime";
                            value: root.is-chinese ? "无" : "None";
                        }
                        MetricRow {
                            label: root.is-chinese ? "启动页内存门禁" : "Start-screen memory gate";
                            value: "≤ 40 MiB target · ≤ 60 MiB hard";
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            if root.page == 2 : Rectangle {
                vertical-stretch: 1;
                background: #f8f9fb;

                VerticalLayout {
                    padding: 48px;
                    spacing: 20px;

                    VerticalLayout {
                        height: 72px;
                        spacing: 7px;

                        Text {
                            text: root.is-chinese ? "设置" : "Settings";
                            color: #101828;
                            font-size: 27px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.is-chinese
                                ? "仅保存在本机。无需账号，也不依赖云端。"
                                : "Stored locally. No account or cloud dependency.";
                            color: #667085;
                            font-size: 12px;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #e4e7ec;
                    }

                    VerticalLayout {
                        spacing: 0px;

                        Text {
                            height: 32px;
                            text: root.is-chinese ? "语言" : "LANGUAGE";
                            color: #98a2b3;
                            font-size: 10px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            height: 38px;
                            spacing: 8px;

                            LanguageChoice {
                                width: 110px;
                                label: root.is-chinese ? "跟随系统" : "System";
                                selected: root.language-mode == 0;
                                activated => { root.set-language(0); }
                            }

                            LanguageChoice {
                                width: 110px;
                                label: "简体中文";
                                selected: root.language-mode == 1;
                                activated => { root.set-language(1); }
                            }

                            LanguageChoice {
                                width: 110px;
                                label: "English";
                                selected: root.language-mode == 2;
                                activated => { root.set-language(2); }
                            }
                        }

                        Rectangle { height: 18px; background: transparent; }

                        Text {
                            height: 32px;
                            text: root.is-chinese ? "界面" : "INTERFACE";
                            color: #98a2b3;
                            font-size: 10px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }

                        SwitchRow {
                            title: root.is-chinese ? "显示状态栏" : "Show status bar";
                            description: root.is-chinese
                                ? "在窗口底部显示轻量的操作反馈。"
                                : "Show lightweight command feedback at the bottom.";
                            checked: root.show-status-bar;
                            toggled => { root.toggle-status-bar(); }
                        }

                        Rectangle { height: 1px; background: #f0f1f3; }

                        SwitchRow {
                            title: root.is-chinese ? "紧凑导航" : "Compact navigation";
                            description: root.is-chinese
                                ? "缩窄侧栏，为文档保留更多横向空间。"
                                : "Use a narrower sidebar and leave more room for documents.";
                            checked: root.compact-navigation;
                            toggled => { root.toggle-compact-navigation(); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            if root.page == 3 : Rectangle {
                vertical-stretch: 1;
                background: #eef1f5;

                VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        height: 58px;
                        background: #ffffff;
                        border-color: #eaecf0;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px;

                                Rectangle { vertical-stretch: 1; background: transparent; }

                                Text {
                                    text: root.docs-title;
                                    color: #101828;
                                    font-size: 15px;
                                    font-weight: 680;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.docs-current-path;
                                    color: #98a2b3;
                                    font-size: 9px;
                                    overflow: elide;
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }

                            Text {
                                text: root.docs-dirty-meta;
                                color: root.docs-dirty-meta == "Saved"
                                    || root.docs-dirty-meta == "已保存"
                                    ? #667085 : #b54708;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            ToolButton {
                                label: root.is-chinese ? "保存" : "Save";
                                enabled: root.docs-can-save;
                                activated => { root.docs-save(); }
                            }
                        }
                    }

                    Rectangle {
                        height: 46px;
                        background: #fbfcfd;
                        border-color: #eaecf0;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 6px;

                            ToolButton {
                                label: root.dense-docs ? "↶" : (root.is-chinese ? "撤销" : "Undo");
                                accessible-name: root.is-chinese ? "撤销" : "Undo";
                                quiet: true;
                                activated => { root.docs-undo(); }
                            }
                            ToolButton {
                                label: root.dense-docs ? "↷" : (root.is-chinese ? "重做" : "Redo");
                                accessible-name: root.is-chinese ? "重做" : "Redo";
                                quiet: true;
                                activated => { root.docs-redo(); }
                            }

                            Rectangle {
                                width: 1px;
                                background: #e4e7ec;
                            }

                            ToolButton {
                                label: "B";
                                active: root.docs-bold;
                                activated => { root.docs-toggle-bold(); }
                            }
                            ToolButton {
                                label: "I";
                                active: root.docs-italic;
                                activated => { root.docs-toggle-italic(); }
                            }
                            ToolButton {
                                label: "U";
                                active: root.docs-underline;
                                activated => { root.docs-toggle-underline(); }
                            }

                            Rectangle {
                                width: 1px;
                                background: #e4e7ec;
                            }

                            ToolButton {
                                label: root.dense-docs ? "←" : (root.is-chinese ? "上一段" : "Previous");
                                accessible-name: root.is-chinese ? "上一段" : "Previous paragraph";
                                quiet: true;
                                activated => { root.docs-previous-paragraph(); }
                            }
                            ToolButton {
                                label: root.dense-docs ? "→" : (root.is-chinese ? "下一段" : "Next");
                                accessible-name: root.is-chinese ? "下一段" : "Next paragraph";
                                quiet: true;
                                activated => { root.docs-next-paragraph(); }
                            }
                            ToolButton {
                                label: root.dense-docs ? "+" : (root.is-chinese ? "+ 段落" : "+ Paragraph");
                                accessible-name: root.is-chinese ? "插入段落" : "Insert paragraph";
                                quiet: true;
                                activated => { root.docs-insert-paragraph(); }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            Text {
                                text: root.dense-docs
                                    ? root.docs-page-meta
                                    : root.docs-page-meta + " · " + root.docs-paragraph-meta;
                                color: #667085;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        Rectangle {
                            width: root.dense-docs ? 188px : 226px;
                            background: #ffffff;
                            border-color: #eaecf0;
                            border-width: 1px;
                            accessible-role: complementary;
                            accessible-label: root.is-chinese ? "文档工具" : "Document tools";

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    height: 28px;
                                    text: root.is-chinese ? "文件" : "FILE";
                                    color: #98a2b3;
                                    font-size: 9px;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text <=> root.docs-path-input;
                                    placeholder-text: root.is-chinese
                                        ? "输入 .docx 文件路径"
                                        : "Enter a .docx file path";
                                    accepted(path) => { root.docs-open-path(path); }
                                }

                                HorizontalLayout {
                                    height: 34px;
                                    spacing: 6px;

                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: root.is-chinese ? "打开" : "Open";
                                        activated => { root.docs-open-path(root.docs-path-input); }
                                    }

                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: root.is-chinese ? "另存为" : "Save As";
                                        enabled: root.docs-can-save;
                                        activated => { root.docs-save-as(root.docs-path-input); }
                                    }
                                }

                                Rectangle { height: 8px; background: transparent; }

                                Text {
                                    height: 28px;
                                    text: root.is-chinese ? "查找与替换" : "FIND & REPLACE";
                                    color: #98a2b3;
                                    font-size: 9px;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text <=> root.docs-search-query;
                                    placeholder-text: root.is-chinese ? "查找" : "Find";
                                    accepted(query) => { root.docs-search(query); }
                                }

                                LineEdit {
                                    text <=> root.docs-replace-text;
                                    placeholder-text: root.is-chinese ? "替换为" : "Replace with";
                                }

                                HorizontalLayout {
                                    height: 34px;
                                    spacing: 6px;

                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: root.is-chinese ? "查找" : "Find";
                                        activated => { root.docs-search(root.docs-search-query); }
                                    }

                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: root.is-chinese ? "全部替换" : "Replace all";
                                        activated => {
                                            root.docs-replace-all(
                                                root.docs-search-query,
                                                root.docs-replace-text
                                            );
                                        }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }

                                Rectangle {
                                    height: 1px;
                                    background: #f0f1f3;
                                }

                                Text {
                                    height: 52px;
                                    text: root.docs-compatibility-text;
                                    color: root.docs-can-save ? #027a48 : #b42318;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: #e9edf2;
                            accessible-role: region;
                            accessible-label: root.is-chinese ? "文档编辑区" : "Document editor";

                            Rectangle {
                                width: parent.width > 790px ? 700px : parent.width - 24px;
                                height: parent.height > 620px ? parent.height - 36px : parent.height - 20px;
                                y: parent.height > 620px ? 18px : 10px;
                                background: #ffffff;
                                border-color: #d8dee7;
                                border-width: 1px;
                                border-radius: 6px;

                                Rectangle {
                                    x: 54px;
                                    y: 42px;
                                    width: parent.width - 108px;
                                    height: parent.height - 84px;
                                    background: transparent;

                                    TextEdit {
                                        width: parent.width;
                                        height: parent.height;
                                        text <=> root.docs-paragraph-text;
                                        font-size: 15px;
                                        edited(text) => { root.docs-edit-paragraph(text); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 4 : Rectangle {
                vertical-stretch: 1;
                background: #f4f6f8;

                VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        height: 56px;
                        background: #ffffff;
                        border-color: #eaecf0;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px;

                                Rectangle { vertical-stretch: 1; background: transparent; }

                                Text {
                                    text: root.sheets-title;
                                    color: #101828;
                                    font-size: 15px;
                                    font-weight: 680;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.sheets-current-path;
                                    color: #98a2b3;
                                    font-size: 9px;
                                    overflow: elide;
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }

                            Text {
                                text: root.sheets-dirty-meta;
                                color: root.sheets-dirty-meta == "Saved"
                                    || root.sheets-dirty-meta == "已保存"
                                    ? #667085 : #b54708;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            ToolButton {
                                label: root.is-chinese ? "保存" : "Save";
                                enabled: root.sheets-can-save;
                                activated => { root.sheets-save(); }
                            }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        background: #fbfcfd;
                        border-color: #eaecf0;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 6px;

                            LineEdit {
                                width: 82px;
                                text <=> root.sheets-address-input;
                                placeholder-text: "A1";
                                accepted(address) => { root.sheets-select-address(address); }
                            }

                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.sheets-cell-input;
                                placeholder-text: root.is-chinese
                                    ? "输入值或公式，例如 =SUM(A1:A3)"
                                    : "Value or formula, e.g. =SUM(A1:A3)";
                                accepted(value) => { root.sheets-edit-cell(value); }
                            }

                            ToolButton {
                                label: "B";
                                accessible-name: root.is-chinese ? "粗体" : "Bold";
                                active: root.sheets-bold;
                                activated => { root.sheets-toggle-bold(); }
                            }

                            ToolButton {
                                label: "I";
                                accessible-name: root.is-chinese ? "斜体" : "Italic";
                                active: root.sheets-italic;
                                activated => { root.sheets-toggle-italic(); }
                            }

                            ToolButton {
                                label: "▧";
                                accessible-name: root.is-chinese ? "切换单元格底色" : "Toggle cell fill";
                                activated => { root.sheets-toggle-fill(); }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #ffffff;
                        clip: true;
                        accessible-role: region;
                        accessible-label: root.is-chinese ? "表格网格" : "Spreadsheet grid";

                        VerticalLayout {
                            spacing: 0px;

                            HorizontalLayout {
                                height: 28px;
                                spacing: 0px;

                                SheetHeaderCell {
                                    width: 48px;
                                    label: "";
                                }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c0; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c1; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c2; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c3; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c4; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c5; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c6; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c7; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c8; }
                                SheetHeaderCell { width: 76px; label: root.sheets-header.c9; }
                            }

                            for row in root.sheets-rows : HorizontalLayout {
                                height: 28px;
                                spacing: 0px;

                                SheetHeaderCell {
                                    width: 48px;
                                    label: row.row-label;
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c0;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c0 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c1;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 1 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c1 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 1); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c2;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 2 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c2 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 2); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c3;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 3 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c3 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 3); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c4;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 4 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c4 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 4); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c5;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 5 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c5 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 5); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c6;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 6 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c6 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 6); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c7;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 7 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c7 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 7); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c8;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 8 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c8 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 8); }
                                }
                                SheetGridCell {
                                    width: 76px;
                                    value: row.c9;
                                    active: row.row-index == root.sheets-active-row
                                        && root.sheets-viewport-column + 9 == root.sheets-active-column;
                                    accessible-name: root.sheets-header.c9 + row.row-label;
                                    activated => { root.sheets-select-cell(row.row-index, root.sheets-viewport-column + 9); }
                                }
                            }

                            Rectangle { vertical-stretch: 1; background: #ffffff; }
                        }
                    }

                    Rectangle {
                        height: 42px;
                        background: #fbfcfd;
                        border-color: #eaecf0;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 5px;

                            ToolButton { label: "←"; accessible-name: root.is-chinese ? "向左滚动列" : "Scroll columns left"; quiet: true; activated => { root.sheets-scroll(0, -5); } }
                            ToolButton { label: "→"; accessible-name: root.is-chinese ? "向右滚动列" : "Scroll columns right"; quiet: true; activated => { root.sheets-scroll(0, 5); } }
                            ToolButton { label: "↑"; accessible-name: root.is-chinese ? "向上滚动行" : "Scroll rows up"; quiet: true; activated => { root.sheets-scroll(-10, 0); } }
                            ToolButton { label: "↓"; accessible-name: root.is-chinese ? "向下滚动行" : "Scroll rows down"; quiet: true; activated => { root.sheets-scroll(10, 0); } }

                            Rectangle { width: 1px; background: #e4e7ec; }

                            Text {
                                text: root.sheets-sheet-name;
                                color: #344054;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            ToolButton {
                                label: "+";
                                accessible-name: root.is-chinese ? "新增工作表" : "Add worksheet";
                                quiet: true;
                                activated => { root.sheets-add-sheet(); }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            ToolButton { label: "A↑"; accessible-name: root.is-chinese ? "按当前列升序" : "Sort ascending"; quiet: true; activated => { root.sheets-sort(true); } }
                            ToolButton { label: "A↓"; accessible-name: root.is-chinese ? "按当前列降序" : "Sort descending"; quiet: true; activated => { root.sheets-sort(false); } }
                            ToolButton { label: root.is-chinese ? "冻结行" : "Freeze row"; quiet: true; activated => { root.sheets-freeze-row(); } }
                            ToolButton { label: root.is-chinese ? "冻结列" : "Freeze col"; quiet: true; activated => { root.sheets-freeze-column(); } }
                        }
                    }

                    Rectangle {
                        height: 42px;
                        background: #ffffff;
                        border-color: #eaecf0;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 6px;

                            LineEdit {
                                width: 160px;
                                text <=> root.sheets-path-input;
                                placeholder-text: root.is-chinese ? "输入 .xlsx 文件路径" : "Enter a .xlsx file path";
                                accepted(path) => { root.sheets-open-path(path); }
                            }

                            ToolButton {
                                label: root.is-chinese ? "打开" : "Open";
                                activated => { root.sheets-open-path(root.sheets-path-input); }
                            }

                            ToolButton {
                                label: root.is-chinese ? "另存为" : "Save As";
                                enabled: root.sheets-can-save;
                                activated => { root.sheets-save-as(root.sheets-path-input); }
                            }

                            Rectangle { width: 1px; background: #e4e7ec; }

                            LineEdit {
                                width: 120px;
                                text <=> root.sheets-filter-input;
                                placeholder-text: root.is-chinese ? "筛选当前列" : "Filter current column";
                            }

                            ToolButton {
                                label: root.is-chinese ? "筛选" : "Filter";
                                activated => { root.sheets-filter(root.sheets-filter-input); }
                            }

                            ToolButton {
                                label: root.is-chinese ? "清除" : "Clear";
                                activated => { root.sheets-clear-filter(); }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            Text {
                                width: 140px;
                                text: root.sheets-compatibility-text;
                                color: root.sheets-can-save ? #027a48 : #b42318;
                                font-size: 9px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }
                    }
                }
            }


            if root.page == 5 : Rectangle {
                vertical-stretch: 1;
                background: #eef1f5;

                VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        height: 56px;
                        background: #ffffff;
                        border-color: #eaecf0;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text {
                                    text: root.slides-title;
                                    color: #101828;
                                    font-size: 15px;
                                    font-weight: 680;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.slides-current-path;
                                    color: #98a2b3;
                                    font-size: 9px;
                                    overflow: elide;
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }

                            Text {
                                text: root.slides-dirty-meta;
                                color: root.slides-dirty-meta == "Saved"
                                    || root.slides-dirty-meta == "已保存"
                                    ? #667085 : #b54708;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            ToolButton {
                                label: root.is-chinese ? "保存" : "Save";
                                enabled: root.slides-can-save;
                                activated => { root.slides-save(); }
                            }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        background: #fbfcfd;
                        border-color: #eaecf0;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 6px;

                            ToolButton { label: "←"; accessible-name: root.is-chinese ? "上一页" : "Previous slide"; quiet: true; activated => { root.slides-previous(); } }
                            ToolButton { label: "→"; accessible-name: root.is-chinese ? "下一页" : "Next slide"; quiet: true; activated => { root.slides-next(); } }

                            Text {
                                text: root.slides-slide-meta;
                                color: #475467;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Rectangle { width: 1px; background: #e4e7ec; }

                            ToolButton { label: root.is-chinese ? "+ 页面" : "+ Slide"; quiet: true; activated => { root.slides-add-slide(); } }
                            ToolButton { label: root.is-chinese ? "复制" : "Duplicate"; quiet: true; activated => { root.slides-duplicate(); } }
                            ToolButton { label: root.is-chinese ? "删除页" : "Delete slide"; quiet: true; activated => { root.slides-delete-slide(); } }

                            Rectangle { width: 1px; background: #e4e7ec; }

                            ToolButton { label: root.is-chinese ? "文本" : "Text"; activated => { root.slides-add-text(); } }
                            ToolButton { label: root.is-chinese ? "形状" : "Shape"; activated => { root.slides-add-shape(); } }
                            ToolButton { label: root.is-chinese ? "表格" : "Table"; activated => { root.slides-add-table(); } }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            ToolButton { label: "↑"; accessible-name: root.is-chinese ? "上移一层" : "Bring forward"; quiet: true; activated => { root.slides-bring-forward(); } }
                            ToolButton { label: "↓"; accessible-name: root.is-chinese ? "下移一层" : "Send backward"; quiet: true; activated => { root.slides-send-backward(); } }
                            ToolButton { label: "×"; accessible-name: root.is-chinese ? "删除元素" : "Delete element"; quiet: true; activated => { root.slides-delete-element(); } }
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        Rectangle {
                            width: root.nav-compact ? 168px : 204px;
                            background: #ffffff;
                            border-color: #eaecf0;
                            border-width: 1px;
                            accessible-role: complementary;
                            accessible-label: root.is-chinese ? "元素列表" : "Element list";

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Text {
                                    height: 26px;
                                    text: root.is-chinese ? "当前页元素" : "SLIDE ELEMENTS";
                                    color: #98a2b3;
                                    font-size: 9px;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                }

                                for element in root.slides-elements : Rectangle {
                                    height: 44px;
                                    border-radius: 7px;
                                    background: #f8f9fb;
                                    border-color: #e4e7ec;
                                    border-width: 1px;
                                    accessible-role: button;
                                    accessible-label: element.kind + " " + element.text;
                                    accessible-action-default => { root.slides-select-element(element.index); }

                                    VerticalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        padding-top: 5px;
                                        padding-bottom: 5px;
                                        spacing: 1px;
                                        Text {
                                            text: element.kind;
                                            color: #344054;
                                            font-size: 10px;
                                            font-weight: 650;
                                        }
                                        Text {
                                            text: element.text;
                                            color: #667085;
                                            font-size: 9px;
                                            overflow: elide;
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.slides-select-element(element.index); }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: #e3e7ed;
                            accessible-role: region;
                            accessible-label: root.is-chinese ? "幻灯片画布" : "Slide canvas";

                            Rectangle {
                                width: parent.width > 880px ? 800px : parent.width - 36px;
                                height: self.width * 0.5625;
                                y: (parent.height - self.height) / 2;
                                x: (parent.width - self.width) / 2;
                                background: #ffffff;
                                border-color: #d0d5dd;
                                border-width: 1px;
                                border-radius: 5px;

                                VerticalLayout {
                                    padding: 34px;
                                    spacing: 12px;

                                    Text {
                                        text: root.slides-slide-meta;
                                        color: #98a2b3;
                                        font-size: 10px;
                                    }

                                    for element in root.slides-elements : Rectangle {
                                        height: 46px;
                                        background: #f9fafb;
                                        border-color: #e4e7ec;
                                        border-width: 1px;
                                        border-radius: 6px;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 10px;
                                            Text {
                                                width: 70px;
                                                text: element.kind;
                                                color: #475467;
                                                font-size: 10px;
                                                font-weight: 650;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: element.text;
                                                color: #101828;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.slides-select-element(element.index); }
                                        }
                                    }

                                    Rectangle { vertical-stretch: 1; background: transparent; }
                                }
                            }
                        }

                        Rectangle {
                            width: root.nav-compact ? 190px : 232px;
                            background: #ffffff;
                            border-color: #eaecf0;
                            border-width: 1px;
                            accessible-role: complementary;
                            accessible-label: root.is-chinese ? "演示文稿工具" : "Presentation tools";

                            VerticalLayout {
                                padding: 12px;
                                spacing: 9px;

                                Text {
                                    height: 26px;
                                    text: root.is-chinese ? "选中元素" : "SELECTED ELEMENT";
                                    color: #98a2b3;
                                    font-size: 9px;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text <=> root.slides-selected-text;
                                    placeholder-text: root.is-chinese ? "选择元素后编辑文字" : "Select an element to edit text";
                                    accepted(value) => { root.slides-edit-text(value); }
                                }

                                ToolButton {
                                    label: root.is-chinese ? "应用文字" : "Apply text";
                                    activated => { root.slides-edit-text(root.slides-selected-text); }
                                }

                                Rectangle { height: 1px; background: #f0f1f3; }

                                Text {
                                    height: 26px;
                                    text: root.is-chinese ? "文件" : "FILE";
                                    color: #98a2b3;
                                    font-size: 9px;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text <=> root.slides-path-input;
                                    placeholder-text: root.is-chinese ? "输入 .pptx 文件路径" : "Enter a .pptx file path";
                                    accepted(path) => { root.slides-open-path(path); }
                                }

                                HorizontalLayout {
                                    height: 34px;
                                    spacing: 6px;
                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: root.is-chinese ? "打开" : "Open";
                                        activated => { root.slides-open-path(root.slides-path-input); }
                                    }
                                    ToolButton {
                                        horizontal-stretch: 1;
                                        label: root.is-chinese ? "另存为" : "Save As";
                                        enabled: root.slides-can-save;
                                        activated => { root.slides-save-as(root.slides-path-input); }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }

                                Text {
                                    height: 54px;
                                    text: root.slides-compatibility-text;
                                    color: root.slides-can-save ? #027a48 : #b42318;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            if root.show-status-bar : Rectangle {
                height: 30px;
                background: #ffffff;
                border-color: #eaecf0;
                border-width: 1px;
                accessible-role: content-info;
                accessible-label: root.is-chinese ? "状态栏" : "Status bar";

                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: root.status-text;
                    color: #667085;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
